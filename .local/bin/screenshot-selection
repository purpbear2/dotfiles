#!/usr/bin/env bash
# Screenshot selected region, launches via Super+F3

set -euo pipefail

for command in slurp grim; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf 'Error: required command not found: %s\n' "$command" >&2
        exit 1
    fi
done

directory="$HOME/Pictures/Screenshots"
timestamp=$(date +%Y-%m-%d_%H-%M-%S)
file="$directory/$timestamp.png"

if ! mkdir -p "$directory"; then
    printf 'Error: unable to create screenshot directory: %s\n' "$directory" >&2
    exit 1
fi

geometry=$(slurp -b 00000055 -c 9ccfd899 -s ffffff55) || exit 0
[[ -n "$geometry" ]] || exit 0

if grim -g "$geometry" "$file"; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i "$file" 'Screenshot saved' "$file" || true
    fi
else
    rm -f "$file" || true
    printf 'Error: failed to save screenshot\n' >&2
    exit 1
fi
