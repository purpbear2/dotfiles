# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1e1e2e"

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#cdd6f4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#89b4fa"

# Background color of selected item in processes box
theme[selected_bg]="#45475a"

# Foreground color of selected item in processes box
theme[selected_fg]="#89b4fa"

# Color of inactive/disabled text
theme[inactive_fg]="#7f849c"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#f5e0dc"

# Background color of the percentage meters
theme[meter_bg]="#45475a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#f5e0dc"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#f9e2af" #Mauve
theme[mem_box]="#89b4fa" #Green
theme[net_box]="#cba6f7" #Yellow
theme[proc_box]="#a6e3a1" #Blue

# Box divider line and small boxes line color
theme[div_line]="#6c7086"

# Temperature graph color (Green -> Yellow -> Mauve)
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#cba6f7"

# CPU graph colors (Green -> Yellow -> Mauve)
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#f9e2af"
theme[cpu_end]="#cba6f7"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#cba6f7"
theme[free_mid]="#b4befe"
theme[free_end]="#89b4fa"

# Mem/Disk cached meter (Yellow -> Green -> Blue)
theme[cached_start]="#f9e2af"
theme[cached_mid]="#a6e3a1"
theme[cached_end]="#89b4fa"

# Mem/Disk available meter (Sapphire -> Blue -> Lavender)
theme[available_start]="#74c7ec"
theme[available_mid]="#89b4fa"
theme[available_end]="#b4befe"

# Mem/Disk used meter (Green -> Teal -> Sapphire)
theme[used_start]="#a6e3a1"
theme[used_mid]="#94e2d5"
theme[used_end]="#74c7ec"

# Download graph colors (Mauve -> Pink -> Flamingo)
theme[download_start]="#cba6f7"
theme[download_mid]="#f5c2e7"
theme[download_end]="#f2cdcd"

# Upload graph colors (Sapphire -> Blue -> Sky)
theme[upload_start]="#74c7ec"
theme[upload_mid]="#89b4fa"
theme[upload_end]="#b4befe"

# Process box color gradient for threads, mem and cpu usage (Mauve -> Lavender -> Subtext 0)
theme[process_start]="#a6e3a1"
theme[process_mid]="#b4befe"
theme[process_end]="#a6adc8"
