[Default Applications]
# Images
image/gif=imv-dir.desktop;
image/jpeg=imv-dir.desktop;
image/png=imv-dir.desktop;
image/svg+xml=imv-dir.desktop;

# Media and terminal
video/x-matroska=io.mpv.Mpv.desktop;
x-scheme-handler/terminal=ghostty.desktop;

# Other
application/octet-stream=hexyl.desktop;
application/pdf=org.pwmt.zathura-pdf-poppler.desktop;
application/vnd.ms-publisher=nvim.desktop;
application/x-desktop=nvim.desktop;
application/x-theme=nvim.desktop;

# Text and code editors
application/javascript=nvim.desktop;
application/json=nvim.desktop;
application/schema+json=nvim.desktop;
application/toml=nvim.desktop;
application/typescript=nvim.desktop;
application/x-perl=nvim.desktop;
application/x-shellscript=nvim.desktop;
application/x-yaml=nvim.desktop;
application/xml=nvim.desktop;
application/yaml=nvim.desktop;
text/*=nvim.desktop;

# Web and browser
text/html=firefox.desktop;
x-scheme-handler/about=firefox.desktop;
x-scheme-handler/http=firefox.desktop;
x-scheme-handler/https=firefox.desktop;
x-scheme-handler/unknown=firefox.desktop;

[Added Associations]
# User overrides
