# Rosé Pine cmus theme
# Modified from: Boris Petrov (https://github.com/Iorvethe)
# Color scheme from: https://rosepinetheme.com/

# Black: 233
# Blue: 38
# Green: 195
# Pink: 181
# Red: 202
# White: 254
# Yellow: 222

# Window
set color_cmdline_bg=default
set color_cmdline_fg=default

set color_win_title_bg=195
set color_win_title_fg=233

set color_win_bg=default
set color_win_fg=default

set color_separator=195

# Bottom status
set color_titleline_bg=195
set color_titleline_fg=233

set color_statusline_bg=default
set color_statusline_fg=default

# Text
set color_win_cur=38
set color_win_dir=default

# Menu
set color_win_sel_bg=181
set color_win_sel_fg=233

set color_win_inactive_sel_bg=default
set color_win_inactive_sel_fg=195

set color_win_cur_sel_bg=181
set color_win_cur_sel_fg=233

set color_win_inactive_cur_sel_bg=default
set color_win_inactive_cur_sel_fg=38

# Messages
set color_error=204
set color_info=38
